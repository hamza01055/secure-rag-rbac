# Copy to .env and fill in. Never commit the filled version.

ENV=development

# Database
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://rag:change-me@localhost:5432/ragdb

# Vector store
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=chunks

# Queue
REDIS_URL=redis://localhost:6379/0

# Auth — generate with: openssl rand -hex 32
# The app should refuse to start if this is shorter than 32 characters.
JWT_SECRET=
JWT_ISSUER=rag-api
JWT_AUDIENCE=rag-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Models — pin these. Changing the embedding model without re-indexing silently
# degrades retrieval and gets misdiagnosed as a filter bug.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
LLM_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Retrieval
TOP_K=5
CHUNK_SIZE_TOKENS=600
CHUNK_OVERLAP_TOKENS=80

# Developer console. Must be false in any deployed environment — the app should
# exit at startup if ENV=production and DEBUG_TRACE=true.
DEBUG_TRACE=true
CORS_ORIGINS=http://localhost:3000,null
